#!/usr/bin/env bash
set -Eeuo pipefail
# Soft guard, not enforcement. Fires only in a clone that has run
# 'git config core.hooksPath .githooks', and 'git push --no-verify'
# bypasses it by design. Nothing protects the default branch server-side:
# this organization's plan and the deliberately uniform cross-SDK contract
# leave every Yes2 SDK without branch protection, rulesets or CODEOWNERS
# (yes2games/yes2dashboard#141 sections 3 and 14). Never read a green
# checklist as "main is protected"; this is the closest in-repo substitute
# and it catches a mistake, not an intent.

# Read the default branch from git rather than hardcoding it, so renaming it
# cannot silently disarm the guard.
default_branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
if [ -z "$default_branch" ]; then
  default_branch=$(git ls-remote --symref origin HEAD 2>/dev/null |
    awk '$1 == "ref:" { sub("refs/heads/", "", $2); print $2; exit }')
fi
default_branch=${default_branch:-main}
protected="refs/heads/${default_branch}"

while read -r _ _ remote_ref _; do
  if [ "$remote_ref" = "$protected" ]; then
    echo "pre-push: direct push to '${default_branch}' is blocked; push a branch and open a PR instead (bypass: --no-verify)." >&2
    exit 1
  fi
done

exit 0
